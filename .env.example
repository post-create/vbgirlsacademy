# Postgres connection string.
# Local dev example:      postgresql://postgres:postgres@localhost:5432/academy
# Azure Postgres example: postgresql://user:password@your-server.postgres.database.azure.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academy

# Port the Express server listens on. Azure App Service sets this automatically in production.
PORT=4000

NODE_ENV=development

# Gmail SMTP credentials for the "Send selvevaluering" notification feature.
# GMAIL_USER is the sending Gmail address; GMAIL_APP_PASSWORD is a 16-character
# App Password (not the normal login password) — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Base URL used to build self-evaluation links in outgoing e-mails.
# In local dev the client normally runs on :5173; leave unset in production —
# the server falls back to its own request origin.
APP_BASE_URL=http://localhost:5173
